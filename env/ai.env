# Local-only development AI service settings. These are not applied to
# production.
#
# Every value here is read by the FastAPI service through os.getenv(), so the
# Python code never hardcodes a hostname. Each variable answers one question:
# where does the text come from, where do the embeddings go, and who writes
# the answer.

# Where the book text is read from. This is the Drupal container's
# /api/book-pages route (see BookPagesController), served on port 80 inside
# the compose network. Containers reach each other by service name.
DRUPAL_BOOK_JSON_URL=http://educationhistory-lib-unb-ca/api/book-pages

# Where chunks and their embeddings are stored. Note the "+psycopg" dialect:
# requirements.txt installs psycopg 3, but a bare "postgresql://" URL makes
# SQLAlchemy look for the older psycopg2 driver and fail on connect.
DATABASE_URL=postgresql+psycopg://eduhist_ai:eduhist_ai@ai-postgres-lib-unb-ca:5432/eduhist_ai

# Ollama runs both models, in its own container on this same network. Nothing
# leaves the machine.
OLLAMA_BASE_URL=http://ai-ollama-lib-unb-ca:11434

# Writes the answers from the retrieved passages.
OLLAMA_MODEL=llama3.2:3b

# Turns text into vectors, for both the book and the questions asked of it.
# all-minilm is all-MiniLM-L6-v2: 384 dimensions, matching Vector(384) in
# models.py. Changing this model means changing that column and re-indexing.
OLLAMA_EMBED_MODEL=all-minilm
