# Local-only development Postgres environment settings. These are not applied
# to production.
#
# This is a second, separate database. Drupal keeps using MariaDB; the vector
# search needs the pgvector extension, which only exists for PostgreSQL.
# Credentials here must match the DATABASE_URL in ai.env.
POSTGRES_DB=eduhist_ai
POSTGRES_PASSWORD=eduhist_ai
POSTGRES_USER=eduhist_ai
